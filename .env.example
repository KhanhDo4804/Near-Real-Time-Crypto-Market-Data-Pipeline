# Copy to .env and fill in locally. Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only for temporary credentials; leave empty for long-lived keys.
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1

# Existing bucket and dedicated prefixes. Replace YOUR_BUCKET before running.
OHLCV_OUTPUT_PATH=s3a://YOUR_BUCKET/market/ohlcv_1m
OHLCV_CHECKPOINT_PATH=/opt/spark/checkpoints/ohlcv-s3

# dbt: copy the workgroup endpoint hostname here (no jdbc:// or :5439/dev)
REDSHIFT_SCHEMA=analytics
REDSHIFT_WORKGROUP=ten-workgroup
REDSHIFT_ACCOUNT_ID=aws-account-id
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_AUTH_METHOD=iam
REDSHIFT_USER=dbt_crypto
REDSHIFT_COPY_ROLE_ARN=arn:aws:iam::850041402358:role/CryptoMarketRedshiftRead
# Only needed when REDSHIFT_AUTH_METHOD=database (not an AWS secret key).
DBT_ENV_SECRET_REDSHIFT_PASSWORD=
